<div class="h1"> CALORIE CALCULATOR SHOW PAGE </div>
<div class="container">
  <div class="row">
    <div class="col-sm-3">
      <%= form_with url: statistics_calorie_calculator_path, method: :post do |f|%>
        <div class="form-group">
          <label for="height">Height</label>
          <%= f.text_field :height, class: 'form-control' %>
        </div>
        <div class="form-group">
          <label for="weight">Weight</label>
          <%= f.text_field :weight, value: @user.current_weight, class: 'form-control' %>
        </div>
        <div class="mb-3">
          <label class="form-label">Ваш уровень активности</label>
          <select name="activity_level" class="form-select">
            <option value="">Выберите уровень</option>
            <% User.activity_levels.keys.each do |al| %>
              <option value="<%= al %>"><%= al.capitalize %></option>
            <% end %>
          </select>
        </div>
        <div class="mt-4">
          <%= f.submit "Сохранить", class: 'btn btn-primary' %>
          <%= link_to "Назад", users_dashboard_path, class: 'btn btn-secondary' %>
        </div>
      <% end %>
    </div>
    <div class="col-sm-4">col-sm-4</div>
  </div>
</div>
